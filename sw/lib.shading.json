:["Imetengenezwa {name} kutoka kwenye picha: inajirudia kila {size} m (mpaka ulikuwa {before}, sasa {after}; 1 haionekani).","7a27e2ff2896"],"shading.photo.h":["Nyenzo kutoka picha","b2ed493ab2df"],"shading.photo.how":["Picha moja inakuwa nyenzo ya kuweka vigae: mwanga unasawazishwa, kingo zinafanywa kuungana, na rangi, ukali na ramani ya normal zinakokotolewa kutoka kwenye picha. Ukali ni makadirio: uweke kulingana na uso. Picha tambarare, ya mraba, iliyopigwa moja kwa moja mbele, hufanya kazi vizuri zaidi.","9e790e0b5290"],"shading.photo.pick":["Picha…","150c0709a176"],"shading.photo.rough":["Ukali wa uso (0 = inang'aa, 1 = chaki)","213d86258771"],"shading.photo.size":["Picha inaonyesha mita hizi kwa upana","02bfd44c0bf6"],"shading.picture.added":["Imeongezwa {name}: nodi mpya ya Picha inaisoma. Unganisha Rangi yake na ingizo.","eeead15fafe2"],"shading.picture.bad":["Picha hiyo haikuweza kusomwa: PNG, JPEG au WebP, si zaidi ya MB 16.","55687bbc4d91"],"shading.tp.color":["Rangi ya brashi","0f921c92b889"],"shading.tp.h":["Paka kwenye umbile","48850dd94c9f"],"shading.tp.hardness":["Ugumu","c5f4f8b1a039"],"shading.tp.hint":["Buruta kwenye uso ili kupaka picha ya nyenzo yake. Esc husimamisha.","65edeffcd7d0"],"shading.tp.how":["Paka kwenye uso wenye mojawapo ya nyenzo za faili hii: brashi hupaka picha iliyo nyuma ya rangi ya msingi, kwenye UV za uso (matundu) au kuvuka uso (nyuso nyingine). Nyenzo yenye rangi tupu hupata picha mpya ya 512 × 512 yenye rangi hiyo. Ctrl+Z hurudisha nyuma mpigo wa mwisho wakati wa kupaka.","17e3e2c7655b"],"shading.tp.made_picture":["{name} sasa inasoma picha unayoweza kupaka.","2a2c3ab9e6ea"],"shading.tp.nothing_to_undo":["Hakuna mpigo wa kurudisha nyuma.","fa8fde807648"],"shading.tp.picture_name":["{name} (imepakwa)","a28da750bdb6"],"shading.tp.radius":["Ukubwa wa brashi (texels)","75b7fa82bad1"],"shading.tp.start":["Paka","50d0cceb2f7a"],"shading.tp.stop":["Acha kupaka","4fc4297e0972"],"shading.tp.strength":["Nguvu","63ee3a1b965a"],"shading.tp.undo":["Tendua mpigo","dc8d513c2b0e"],"shading.tp.undone":["Imerudishwa nyuma mpigo wa mwisho.","7045bbd8ac7d"],"shading.tp.why.library":["Nyenzo za maktaba haziwezi kupakwa. Tengeneza nakala inayoweza kuhaririwa (paneli ya Uvuli) kisha upake hiyo.","477659a1569d"],"shading.tp.why.mapping":["Nyenzo hii imewekwa kwa boksi au triplanar. Kupaka kunahitaji uwekaji wa UV (Pato la nyenzo › Uwekaji).","ece84ecf3f56"],"shading.tp.why.no_material":["Uso huu hauna nyenzo yoyote ya faili hii. Kwanza paka mojawapo ya nyenzo za faili juu yake.","7003d6ca6286"],"shading.tp.why.no_uv":["Matundu haya hayana UV za kupakia. Ifunue kwanza kwenye eneo kazi la UV.","2bbe6e985c91"],"shading.tp.why.nodes":["Rangi ya msingi ya nyenzo hii inatoka kwa nodi nyingine. Unganisha nodi ya Picha kwenye Rangi ya msingi ili kuipaka.","b0f1c05e7618"],"shading.why.no_material":["Tengeneza au chagua nyenzo kwanza.","32dbfe1b67cb"]}}