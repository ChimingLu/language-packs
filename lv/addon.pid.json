c613"],"check.ln-changes":["Līnija {a} tieši pāriet līnijā {b} bez starpelementa: pievienojiet reducētāju vai specifikācijas pāreju.","a758f7cdb6dc"],"check.no-line-number":["Procesa līnijai nav līnijas numura.","6b05d2078a58"],"check.no-loop":["Instrumentam {tag} nav cilpas numura.","f06e2ad41013"],"check.no-tag":["{what} nav marķējuma.","51cf9ae4a0d8"],"check.open-end":["Līnijas ({ln}) {style} gals nekur nebeidzas.","507e703016db"],"check.open-port":["{what}: puse {port} nekur nepievienojas.","9885eb1a8524"],"cmd.pidcalc.help":["Palaist procesa kalkulatoru (izgarošana, plūsmas shēma, siltummainis, tvertne, tīkls, cauruļvada spriegums, drošības vārsts, HAZOP, LOPA, sekas un citi) un skatīt tā rezultātus un problēmas.","9e1ec5f0e036"],"cmd.pidcheck.help":["Pārbaudīt shēmu par neiezīmētiem elementiem, dublētiem marķējumiem, atvērtiem līniju galiem un citiem trūkumiem un tuvināt katru no tiem.","d19d99d1b49e"],"cmd.pidconseq.help":["Izzīmēt uz lapas seku kalkulatora zonas (starojuma, sprādziena vai izplūdes laukumus) slāņos CONSEQ-1, CONSEQ-2 … Provizorisks rezultāts; nav pārskatīts inženieru.","3a00d21bf571"],"cmd.pidfeeds.help":["Iestatīt procesa modeļa padeves no straumju tabulas, ko importējāt (Imports › Straumju tabula)","adf69597a683"],"cmd.pidhazop.help":["Pārskatiet HAZOP rindas, ko ieteica jūsu asistents: pieņemiet vai noraidiet tās pēc ID. Asistents pats nekad nepieņem rindu.","7d5c00ffe970"],"cmd.pidhen.help":["Izzīmēt siltummaiņu tīkla režģi no straumju datiem (pinch dizains): karstās straumes augšā, aukstās apakšā, pinch līnija, savienojumi ar to slodzēm, sildītāji un dzesētāji.","4865112b57ed"],"cmd.pidline.help":["Zīmēt procesa līniju vai signāla līniju (pneimatisku, elektrisku, programmatūras, kapilāro). Procesa līnijai tiek piešķirts līnijas numurs, kas veidots no tās izmēra, vides, secības un specifikācijas.","39bf2010020c"],"cmd.pidlist.help":["Ievietot līniju sarakstu, iekārtu sarakstu, instrumentu indeksu vai vārstu sarakstu lapā kā tabulu, kas paliek atjaunota.","b262f18b01aa"],"cmd.pidlive.help":["Novietot iekārtas vērtības blakus marķētajiem simboliem, krāsojot tās pēc stāvokļa: no vēsturnieka CSV (tag,time,value,quality) vai no CadCraft Studio iekārtas savienojuma. Tikai lasīšanai.","8b958b451d60"],"cmd.pidln.help":["Iestatīt procesa līniju izmēru, vidi un specifikāciju un numurēt tās.","eb5923014150"],"cmd.pidnode.help":["Izzīmēt HAZOP mezgla robežu ar diviem stūriem. Tajā esošie iekārtu marķējumi un līniju numuri aizpilda mezglu, un tas tiek saglabāts kopā ar rasējumu.","b82d19484d69"],"cmd.pidpfd.help":["Izzīmēt procesa modeļa procesa plūsmas diagrammu: iekārtas kolonnās pēc plūsmas, straumes ar to nosaukumiem, temperatūru un spiedienu, cirkulācijas cauruļvadi augšā un zemāk straumju tabula.","9182fe05aa6f"],"cmd.pidplume.help":["Izzīmēt skursteņa izplūdes kontūras no gaisa kalkulatora uz lapas, ar skursteni, vēja bultu un piezīmi, ka tas ir provizorisks, nevis atļaujas modelis.","74cebf833fce"],"cmd.pidproc.help":["Saistīt rasējumu ar procesa modeli, palaist to, izzīmēt tā straumju tabulu, mainīt līnijas izmēru un nodot to tālāk vai uzskaitīt vadības sistēmas līnijas.","f838f60d4fbe"],"cmd.pidrelief.help":["Noteikt drošības vārsta izmēru ar drošības vārsta kalkulatora ievadēm un uzrakstīt tā atveres burtu un laukumu uz simbola. Nav pārskatīts inženieru.","7e4ab1e65f30"],"cmd.pidsources.help":["Nolasīt izdalīšanās avotus no rasējuma iekārtām un armatūras, klasificēt tos ar apgabala kalkulatora pakotni un saglabāt zonas PIDZONE vajadzībām. Provizorisks rezultāts, nevis inženiertehniskais apstiprinājums; nav pārskatīts inženieru.","cbf7e6cb8503"],"cmd.pidsymbol.help":["Novietot P&ID simbolus: vārstus, iekārtas, instrumentus, līniju elementus un savienotājus. Līnijas elementa simbols, kas novietots uz procesa līnijas, pārtrauc līniju abās tā pusēs.","55a945418ba0"],"cmd.pidtag.help":["Piešķirt simbolam marķējumu un aprakstu vai uzreiz iezīmēt visas neiezīmētās iekārtas (A).","8359b333d8f7"],"cmd.pidtubesheet.help":["Izzīmēt siltummaiņa cauruļu plāksni no siltummaiņa kalkulatora ievades: apvalks, katra caurule un ejas josla.","4c36bcd853b0"],"cmd.pidzone.help":["Izzīmēt bīstamo zonu apgabalus no apgabala kalkulatora uz lapas: plāna riņķus vai griezumu caur izplūdi. Slāņi AREA-ZONE0, AREA-ZONE1 un AREA-ZONE2. Provizorisks rezultāts, nevis inženiertehniskais apstiprinājums.","8f45934f3877"],"conseq.done":["Izzīmētās seku zonas: {n}.","62f0ded75cd4"],"ctl.done":["Marķieri: {tags}, I/O kanāli: {io}, cilpas: {loops}.","39b2076cae43"],"ctl.export.csv":["Vadības sistēmu saraksti (CSV)","e1118a6e1d6b"],"ctl.export.xlsx":["Vadības sistēmu saraksti (darblapa)","5debc552fea6"],"ctl.io":["Kanāli: {ai} analogās ieejas, {ao} analogās izejas, {di} digitālās ieejas, {do} digitālās izejas (pirms rezerves).","a94dc70398b8"],"ctl.loop":["Cilpa {id} {name}","d44398a7b121"],"ctl.loops.done":["Izzīmēto cilpu lapas: {n}.","149b48a3a738"],"ctl.noloops":["Starp marķieriem netika atrasta neviena cilpa ar diviem vai vairāk ierīcēm.","03bd23d30188"],"done.autotag":["Iezīmēti: {n}.","5283d789af7d"],"done.autotag.skipped":["Instrumentiem jāuzraksta burti: {n}. Iezīmējiet tos pa vienam.","d5fdb00aaf2d"],"done.check":["Kļūdas: {errors}, brīdinājumi: {warnings}.","11d3b5158490"],"done.continue":["Turpina ar: {ln}.","3d28adb828fa"],"done.line":["Zīmēts ({style}), segmenti: {n}.","29f0595dfc06"],"done.line.ln":["Līnijas numurs: {ln}.","9a61b4dd1cdf"],"done.list.count":["{name}: rindas: {n}.","4c02ca61742d"],"done.match":["Lauki no: {ln}.","7a0425ca1a35"],"done.pidln":["Iestatītas līnijas: {n}.","8e84d8df445b"],"done.table":["Saraksts ir lapā un tiek atjaunots.","b5fb6b315be7"],"err.empty":["Šajā rasējumā vēl nav P&ID.","65e0e42e5bd7"],"err.line":["Šai līnijai ir pārāk maz punktu.","94793e5dba0b"],"err.notline":["Tur nav procesa vai signāla līnijas.","caaccfc54281"],"err.notsymbol":["Tur nav simbola.","ab537afefb7a"],"export.csv":["P&ID saraksti (CSV)","b024ba9cb6b3"],"export.dexpi":["DEXPI procesa mo