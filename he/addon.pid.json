ת שלו.","9e1ec5f0e036"],"cmd.pidcheck.help":["בדיקת התרשים לפריטים שלא תויגו, תגים כפולים, קצוות קו פתוחים ועוד, וזום לכל אחד מהם.","d19d99d1b49e"],"cmd.pidconseq.help":["שרטוט אזורי מחשבון ההשלכות על הגיליון (טביעות רגל של קרינה, פיצוץ או נוצה) בשכבות CONSEQ-1, CONSEQ-2 … תוצאת סינון; לא נבדק על ידי מהנדס.","3a00d21bf571"],"cmd.pidfeeds.help":["הגדרת הזנות מודל התהליך מטבלת הזרמים שיובאה (ייבוא › טבלת זרמים)","adf69597a683"],"cmd.pidhazop.help":["סקירת שורות HAZOP שהציע העוזר: קבלה או דחייה שלהן לפי שם. העוזר לעולם אינו מקבל שורה בעצמו.","7d5c00ffe970"],"cmd.pidhen.help":["שרטוט רשת מחליפי החום מנתוני זרמים (תכנון pinch): זרמים חמים בראש, קרים מתחת, קו ה-pinch, התאמות עם העומסים שלהן, מחממים ומקררים.","4865112b57ed"],"cmd.pidline.help":["שרטוט קו תהליך או קו אות (פנאומטי, חשמלי, תוכנה, נימי). לקו תהליך נבנה מספר קו מהגודל, השירות, הסידור והמפרט שלו.","39bf2010020c"],"cmd.pidlist.help":["הצבת רשימת קווים, רשימת ציוד, אינדקס מכשירים או רשימת שסתומים על הגיליון כטבלה שמתעדכנת באופן שוטף.","b262f18b01aa"],"cmd.pidlive.help":["הצבת ערכי המתקן לצד הסמלים המתויגים, בצבעים לפי מצב: מקובץ CSV של היסטוריון (tag,time,value,quality) או מחיבור המתקן של Studio. לקריאה בלבד.","8b958b451d60"],"cmd.pidln.help":["קביעת גודל, שירות ומפרט של קווי תהליך, והענקת מספרים להם.","eb5923014150"],"cmd.pidnode.help":["שרטוט גבול צומת HAZOP בעזרת שתי פינות. תגיות הציוד ומספרי הקווים שבתוכו ימלאו את הצומת, והוא נשמר עם השרטוט.","b82d19484d69"],"cmd.pidpfd.help":["שרטוט תרשים זרימת התהליך של מודל התהליך: יחידות בעמודות לפי הזרימה, זרמים עם שמותיהם, טמפרטורה ולחץ, מחזורים בחלק העליון, וטבלת הזרמים מתחתיו.","9182fe05aa6f"],"cmd.pidplume.help":["שרטוט קווי הגובה של הנוצה מהארובה במחשבון האוויר על הגיליון, עם הארובה, חץ הרוח והערה שמדובר בסינון ולא במודל אישור.","74cebf833fce"],"cmd.pidproc.help":["קישור השרטוט למודל התהליך, הפעלתו, שרטוט טבלת הזרמים שלו, שינוי גודל קו והעברתו הלאה, או הצגת רשימות קווי מערכת הבקרה.","f838f60d4fbe"],"cmd.pidrelief.help":["מידת שסתום שחרור בשרטוט לפי הקלט של מחשבון השחרור, וכתיבת האות והשטח של פתח הזרימה על הסמל. לא נבדק על ידי מהנדס.","7e4ab1e65f30"],"cmd.pidsources.help":["קריאת מקורות השחרור מהציוד והאביזרים בשרטוט, סיווגם בעזרת חבילת מחשבון השטחים ושמירת האזורים עבור PIDZONE. תוצאת סינון בלבד, לא אישור הנדסי; לא נבדק על ידי מהנדס.","cbf7e6cb8503"],"cmd.pidsymbol.help":["הצבת סמלי P&ID: שסתומים, ציוד, מכשירים, פריטים על הקו ומחברים. סמל על קו תהליך שנלחץ עליו חותך את הקו משני צדדיו.","55a945418ba0"],"cmd.pidtag.help":["מתן תג ותיאור לסמל, או תיוג כל ציוד שלא תויג בבת אחת (A).","8359b333d8f7"],"cmd.pidtubesheet.help":["שרטוט לוח הצינורות של מחליף חום לפי הקלט של מחשבון מחליף החום: המעטפת, כל צינור ומסלול המעבר.","4c36bcd853b0"],"cmd.pidzone.help":["שרטוט אזורי הסיכון מתוך מחשבון השטחים על הגיליון: מעגלים בתוכנית, או חתך דרך השחרור. שכבות AREA-ZONE0, AREA-ZONE1 ו-AREA-ZONE2. תוצאת סינון בלבד, לא אישור הנדסי.","8f45934f3877"],"conseq.done":["שורטטו {n} אזורי השלכות.","62f0ded75cd4"],"ctl.done":["{tags} תגיות, {io} ערוצי I/O, {loops} לולאות.","39b2076cae43"],"ctl.export.csv":["רשימות מערכת בקרה (CSV)","e1118a6e1d6b"],"ctl.export.xlsx":["רשימות מערכת בקרה (חוברת עבודה)","5debc552fea6"],"ctl.io":["ערוצים: {ai} אנלוגי כניסה, {ao} אנלוגי יציאה, {di} דיגיטלי כניסה, {do} דיגיטלי יציאה (לפני רזרבה).","a94dc70398b8"],"ctl.loop":["לולאה {id} {name}","d44398a7b121"],"ctl.loops.done":["נשרטטו {n} גיליונות לולאה.","149b48a3a738"],"ctl.noloops":["לא נמצאו לולאות עם שני מכשירים ומעלה מבין התגיות.","03bd23d30188"],"done.autotag":["תויגו {n}.","5283d789af7d"],"done.autotag.skipped":["{n} מכשירים דורשים אותיות: תייגו אותם אחד-אחד.","d5fdb00aaf2d"],"done.check":["{errors} שגיאות, {warnings} אזהרות.","11d3b5158490"],"done.continue":["ממשיכים עם {ln}.","3d28adb828fa"],"done.line":["{style} שורטט, {n} מקטעים.","29f0595dfc06"],"done.line.ln":["מספר הקו {ln}.","9a61b4dd1cdf"],"done.list.count":["{name}: {n} שורות.","4c02ca61742d"],"done.match":["משתמשים בשדות של {ln}.","7a0425ca1a35"],"done.pidln":["הוגדרו {n} קווים.","8e84d8df445b"],"done.table":["הרשי