{"@format":"cadcraft-lang-layer","@layer":"lib.shading","@locale":"ta","s":{"shading.bake.cage":["செங்குத்துகளுக்குத் தேடல் தூரம் (cm)","48d5a489fb7d"],"shading.bake.cancel":["பேக் செய்வதை நிறுத்து","43a77d8d02b2"],"shading.bake.cancelled":["பேக் செய்வது நிறுத்தப்பட்டது. எதுவும் சேர்க்கப்படவில்லை.","f084ded27abf"],"shading.bake.dist":["மறைப்புத் தூரம் (m, 0 = மாதிரியின் கால் பங்கு)","497716205040"],"shading.bake.done":["{maps} {size} × {size} இல் {s} வி இல் பேக் செய்யப்பட்டன. படங்கள் கோப்பில் உள்ளன: படம் நோடில் அவற்றைத் தேர்ந்தெடுக்கவும்.","66f365c5ff61"],"shading.bake.failed":["பேக் முடியவில்லை. சிறிய படத்தின் அளவு அல்லது குறைவான கதிர்களை முயலவும்.","33b1e5c0e5df"],"shading.bake.go":["பேக் செய்","6a3d4a29a1a8"],"shading.bake.h":["அமைப்புகளைப் பேக் செய்","fa315ec60404"],"shading.bake.how":["UV கள் கொண்ட வலையைத் தேர்ந்தெடுக்கவும் (UV பணியிடத்தில் விரிக்கவும்). செங்குத்துகளுக்கு உயர்-நுணுக்கப் பொருளையும் தேர்ந்தெடுக்கவும்: குறைவான முக்கோணங்கள் கொண்டதன் மீது பேக் செய்யப்படும். படங்கள் கோப்பில் சேரும்; திறந்த மெட்டீரியலின் அழுக்கும் விளிம்புத் தேய்மானமும் நோடுகள் மறைப்பையும் வளைவையும் பெறும்.","bf95b99a59cb"],"shading.bake.map.ao":["சூழல் மறைப்பு","17ce0283085f"],"shading.bake.map.curvature":["வளைவு","30baef7d32d3"],"shading.bake.map.light":["ஒளியூட்டல்","07607d609f9a"],"shading.bake.map.normal":["உயர்-நுணுக்கப் பொருளிலிருந்து செங்குத்துகள்","eda7479f1aab"],"shading.bake.object":["பொருள்","62a6da8735c1"],"shading.bake.picture_name":["{name} {map}","7822c57894aa"],"shading.bake.rays":["ஒரு டெக்சலுக்குக் கதிர்கள் (மறைப்பு மற்றும் ஒளியூட்டல்)","934b200ded0a"],"shading.bake.size":["படத்தின் அளவு","28a0f4295d32"],"shading.bake.wear":["திறந்த மெட்டீரியலின் அழுக்கும் விளிம்புத் தேய்மானமும் நோடு இப்போது அவற்றைப் படிக்கிறது.","51c6ae446a76"],"shading.bake.why.no_high":["செங்குத்துகளுக்கு இரண்டாவது, உயர்-நுணுக்கப் பொருளும் தேர்ந்தெடுக்கப்பட வேண்டும்; மற்ற வரைபடங்கள் பேக் செய்யப்பட்டன.","220405e02d66"],"shading.bake.why.no_uv":["இந்த வலைக்கு UV கள் இல்லை. முதலில் UV பணியிடத்தில் விரிக்கவும்.","7a79a0e6ff2d"],"shading.bake.why.not_mesh":["பேக் செய்வது வலையின் UV கள் வழியே எழுதுகிறது. முதலில் பொருளை வலையாக மாற்றி UV பணியிடத்தில் விரிக்கவும்.","2cdf5c89b156"],"shading.bake.why.select":["பேக் செய்ய ஒரு வலையைத் தேர்ந்தெடுக்கவும் (அல்லது இரண்டை: குறைவானது, உயர்-நுணுக்கமானது).","14099696b735"],"shading.bake.width":["வளைவுக்கு விளிம்பு அகலம் (cm)","00717fedfbd0"],"shading.cat.color":["வண்ணம்","6b73191a0a4b"],"shading.cat.input":["உள்ளீடு","36ecb4f86691"],"shading.cat.math":["கணிதம்","d48500aea832"],"shading.cat.output":["வெளியீடு","b2439bcb8dee"],"shading.cat.texture":["அமைப்பு","e28411a3404d"],"shading.cat.vector":["வெக்டர்","a56ad3f24408"],"shading.cmd.add":["நோடு சேர்","35a1b64211a7"],"shading.cmd.add.title":["வரைபடத்தில் நோடு சேர் (நோடு திருத்தியில் Shift+A)","a2f030d75222"],"shading.cmd.decal":["டிகால்","8251b49c71d0"],"shading.cmd.decal.title":["ஒரு படத்தை மேற்பரப்பில் தனி மெட்டீரியலுடன் டிகாலாக வை","6aec025147ab"],"shading.cmd.delete":["நீக்கு","e2d0a54968ea"],"shading.cmd.delete.title":["இந்த மெட்டீரியலைக் கோப்பிலிருந்து நீக்கு","8cbffb0836a9"],"shading.cmd.done":["முடிந்தது","11a6767d5674"],"shading.cmd.done.title":["மாதிரிப் பணியிடத்துக்குத் திரும்பு","585ae9f98b4f"],"shading.cmd.duplicate":["நகலாக்கு","02cdaabfca80"],"shading.cmd.duplicate.title":["நகலை மாற்ற, இந்த மெட்டீரியலை நகலெடு","80cdaa330f1a"],"shading.cmd.frame":["அனைத்து நோடுகளையும் காட்டு","1112ac39122f"],"shading.cmd.frame.title":["நோடு திருத்தியில் ஒவ்வொரு நோடையும் பொருத்து (F)","a569971239b2"],"shading.cmd.new":["புதிய மெட்டீரியல்","dfe2edea2292"],"shading.cmd.new.title":["இந்தக் கோப்பின் புதிய மெட்டீரியல் உருவாக்கி அதன் நோடுகளைத் திருத்து","78fd29101939"],"shading.cmd.paint":["இதனால் வண்ணமிடு","d47b412359a5"],"shading.cmd.paint.title":["தேர்வை இந்த மெட்டீரியலால் வண்ணமிடு, அல்லது வண்ணமிடு கருவிக்கு இதைத் தேர்ந்தெடு","9206d2612591"],"shading.cmd.texpaint":["அமைப்பு வண்ணம்","b9485f81c4c7"],"shading.cmd.texpaint.title":["ஒரு முகத்தின் மெட்டீரியலின் படத்தின் மீது தூரிகையால் வண்ணம