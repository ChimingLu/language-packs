,"63ee3a1b965a"],"shading.tp.undo":["கீறலைச் செயல்தவிர்","dc8d513c2b0e"],"shading.tp.undone":["கடைசிக் கீறல் திரும்பப் பெறப்பட்டது.","7045bbd8ac7d"],"shading.tp.why.library":["நூலக மெட்டீரியல்களுக்கு வண்ணமிட முடியாது. திருத்தக்கூடிய நகலை (நிழலிடல் பலகம்) உருவாக்கி அதற்கு வண்ணமிடவும்.","477659a1569d"],"shading.tp.why.mapping":["இந்த மெட்டீரியல் பெட்டி அல்லது மூன்று தள வரைபடத்தால் வைக்கப்பட்டுள்ளது. வண்ணமிட UV வரைபடம் தேவை (மெட்டீரியல் வெளியீடு › வரைபடம்).","ece84ecf3f56"],"shading.tp.why.no_material":["இந்த முகம் இந்தக் கோப்பின் மெட்டீரியல் எதையும் அணியவில்லை. முதலில் கோப்பின் மெட்டீரியல்களில் ஒன்றை அதன் மீது பூசவும்.","7003d6ca6286"],"shading.tp.why.no_uv":["இந்த வலைக்கு வண்ணமிட UV கள் இல்லை. முதலில் UV பணியிடத்தில் விரிக்கவும்.","2bbe6e985c91"],"shading.tp.why.nodes":["இந்த மெட்டீரியலின் அடிப்படை வண்ணம் பிற நோடுகளிலிருந்து வருகிறது. வண்ணமிட படம் நோடை அடிப்படை வண்ணத்துடன் இணைக்கவும்.","b0f1c05e7618"],"shading.why.no_material":["முதலில் மெட்டீரியலை உருவாக்கவும் அல்லது தேர்ந்தெடுக்கவும்.","32dbfe1b67cb"]}}