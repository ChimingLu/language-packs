லிருந்து ஒரு வணிக அளவு).","dbe54a987475"],"carrier.fill.bad":["{run} {size}: {pct} % என்பது {limit} % வரம்பைத் தாண்டுகிறது ({cables}). அவற்றைத் தாங்கும் அடுத்த அளவு: {bigger}.","655c519ab76a"],"carrier.fill.nood":["{run} {size}: நிரப்புதல் மதிப்பிடப்படவில்லை, ஒரு கேபிளுக்கு வெளிவிட்டம் இல்லை ({cables}).","6377bfade987"],"carrier.fill.ok":["{run} {size}: {limit} % இல் {pct} % ({cables}).","86a00c0d0a22"],"carrier.head":["{n} கேபிள்கள்:","0fc4d1f68e2a"],"carrier.nocircuits":["எந்த மின்சுற்றுக்கும் பலகையும் சாதனங்களும் இல்லை, எனவே வழிப்படுத்த கேபிள் இல்லை.","d7f6ed11022e"],"carrier.nood":["இவற்றுக்கு வெளிவிட்டம் தட்டச்சு செய்யப்படவில்லை: {list}. ELCARRIER › வெளிவிட்டம் பயன்படுத்தவும். காட்டப்படும் நிரப்பு வரம்புகள் பெயரிடப்பட்ட இயல்புகள்; நடைமுறையில் உள்ள விதிமுறையே முடிவு செய்யும்.","545bb0b8c90a"],"carrier.noroutes":["முதலில் EL-ROUTE எனத் தொடங்கும் அடுக்கில் பாதைக் கோடுகளைத் தேர்ந்தெடுக்கவும்.","51e2afbd5887"],"carrier.od":["{type}: வெளிவிட்டம் {mm} mm.","889745cf37b3"],"carrier.od.cleared":["{type}: வெளிவிட்டம் அழிக்கப்பட்டது.","a93a8c6b2274"],"carrier.set":["{n} பாதைகள் அடுக்கு {layer} க்கு மாற்றப்பட்டன.","2d079e1937d3"],"carrier.title":["கேபிள் அட்டவணை","a3e1510100b1"],"carrier.unrouted":["இவற்றில் பலகையிலிருந்து சாதனத்துக்குத் தொடர்ச்சியான பாதை இல்லை: {list}.","b21e70290cc1"],"check.cable-cores":["கேபிள் {tag} {n} கம்பிகளைச் சுமக்கிறது ஆனால் {cores} உள்ளகங்கள் மட்டுமே (/{place})","48b0d6ab7514"],"check.dup-addr":["PLC முகவரி {addr} இரு முறை பயன்படுத்தப்பட்டுள்ளது ({place})","0034e135a41b"],"check.dup-tag":["{tag} இரு முறை பயன்படுத்தப்பட்டுள்ளது ({place})","17420ac8dcdc"],"check.mirror-full":["{tag} க்கு {n} தொடுப்புக் கோடுகள்; அதன் பிரதிபலிப்பு {max} காட்டுகிறது (/{place})","8053a4a40d82"],"check.near-overload":["மின்சுற்று {circuit} {amps} A இழுக்கிறது, அதன் {breaker} A பிரேக்கரின் {pct} % ஐத் தாண்டுகிறது","7e74433b75f3"],"check.no-breaker":["மின்சுற்று {circuit} க்குச் சுமைகள் உள்ளன ஆனால் பிரேக்கர் மதிப்பீடு இல்லை","f744e5c5f086"],"check.no-circuit":["{what} எந்த மின்சுற்றிலும் இல்லை (/{place})","fba1f1b80c63"],"check.no-coil":["{tag} இன் தொடுப்புகளுக்குச் சுருள் இல்லை ({place})","67d41c2bb9ac"],"check.no-contact":["{tag} இன் தொடுப்பு எதுவும் வரையப்படவில்லை (/{place})","80c6f43a7065"],"check.no-rcd":["மின்சுற்று {circuit} சாக்கெட் புள்ளிகளுக்கு மின் வழங்குகிறது, ஆனால் 30 mA அல்லது குறைவான எஞ்சிய மின்னோட்டச் சாதனம் எதையும் குறிப்பிடவில்லை (RCD: {rcd})","ab6b9079334c"],"check.no-tag":["{what} க்குக் குறிச்சொல் இல்லை (/{place})","550cffd1d913"],"check.open-end":["ஒரு கம்பி முனை எதனுடனும் இணைக்கப்படவில்லை (/{place})","0b0b662e3abd"],"check.overload":["மின்சுற்று {circuit} {breaker} A பிரேக்கரில் {amps} A இழுக்கிறது","111b84cd2953"],"check.through":["ஒரு கம்பி {tag}:{pin} வழியாகச் சென்று அதைக் குறுக்குகிறது (/{place})","d0c24c5fb9ed"],"check.wireno-orphan":["கம்பி எண் {value} எந்தக் கம்பியிலும் இல்லை (/{place})","b606ee60870b"],"cmd.elbalance.help":["ஒற்றைக் கட்ட மின்சுற்றுகளை மூன்று கட்டங்களிலும் பரப்பு","fc4b670f6207"],"cmd.elcable.help":["கேபிள் சுமக்கும் கம்பிகளின் குறுக்கே அதைக் குறி","358c93d43451"],"cmd.elcarrier.help":["கேபிள் தட்டுகளும் குழாய்களும்: ஒரு பாதையின் அளவு, வகையை அமை, ஒவ்வொரு கேபிளின் வெளிவிட்டத்தைத் தட்டச்சு செய், பிறகு கேபிள் நீளங்களையும் நிரப்புதலையும் பட்டியலிட்டு கேபிள் அட்டவணையைச் சேமி (ELCR)","b295ee2c294a"],"cmd.elcheck.help":["சுற்று வரைபடத்தையும் மின்சுற்றுகளையும் சரிபார்","385db11ff8d2"],"cmd.elcircuit.help":["சாதனங்களை ஒரு மின்சுற்றில் இடு, அல்லது ஒரு மின்சுற்றை வரையறு","000590f15856"],"cmd.eldesignblock.help":["புதிய குறிச்சொற்கள் மற்றும் கம்பி எண்களுடன் வடிவமைப்புத் தொகுதியை வை; அல்லது ஒன்றை இறக்குமதி, ஏற்றுமதி அல்லது நீக்கு","02b815caa811"],"cmd.elimportsym.help":["DWG அல்லது DXF குறியீட்டு நூலகத்தின் தொகுதிகளை மின்சாரக் குறியீடுகளாக இறக்குமதி செய்","c39366c7641d"],"cmd.elinstall.help":["தளத்தில் மின்னிணைப்புப் புள்ளிகள், சுவிட்சுகள், விளக்குகளை வை","2e4eb8580cb5"],"cmd.elnumber.help":["தாள், பாதை, வரிசையின்படி கம்பிகளுக்கு எண்ணிடு","dbe63f11dc57"],"cmd.elpanel.help":["பலகை அட்டவணை: மின்சுற்