{"@format":"cadcraft-lang-layer","@layer":"addon.piping","@locale":"ta","s":{"ask.class":["ஷெட்யூல் அல்லது வகை","701eba5beea3"],"ask.instrument":["கருவிக் குறிச்சொல்: எழுத்துகளும் எண்ணும் (PI 101)","0256d9bac2a8"],"ask.lines":["ஒற்றை அல்லது இரட்டைக் கோடு","fc5b58e50f65"],"ask.material":["பொருள்","616cb218a65b"],"ask.pidsym":["{sym} வர வேண்டிய இடம்","dde9af83a3a5"],"ask.pipe.first":["குழாய்ப் பாதையின் முதல் புள்ளி ({size}); ஒரு குழாயிலிருந்து கிளைக்க அதன் மீது தொடங்கவும்","0fda470bfbe3"],"ask.pipe.next":["அடுத்த புள்ளி ({size}); ஒரு குழாயுடன் இணைக்க அதன் மீது முடிக்கவும்","bf13fc11fbaf"],"ask.size.in":["அங்குலத்தில் பெயரளவு அளவு ({list})","214490510673"],"ask.size.mm":["அளவு: DN அல்லது பெயரளவு ({list})","9d7389f8e977"],"ask.slope.in":["சரிவு, அடிக்கு அங்குலம் (1/4, 1/8, சமமாக இருக்க 0)","274fe99edc6d"],"ask.slope.mm":["சரிவு சதவீதத்தில் (2, 1, சமமாக இருக்க 0)","248536c9e166"],"ask.symbol":["குறியீடு","ba0e4afa9340"],"ask.tag":["குறிச்சொல் (எ.கா. CW-1)","97b7f077a5db"],"ask.valve":["{type} வர வேண்டிய குழாயைக் கிளிக் செய்யவும்","b610afaec11b"],"ask.valve.remove":["எடுக்க வேண்டிய வால்வைக் கிளிக் செய்யவும்","04b6d28c12dc"],"ask.valvekind":["வகை","f5387f9bb6ed"],"ask.z":["தொடக்கத்தில் மையக்கோட்டு உயரம் <{z}>","0e7b3bb17475"],"cmd.pidsym.help":["திட்டக் குறியீடுகளை வை: வால்வுகள், பம்ப், நிவாரண வால்வு, கருவி வட்டங்கள், ஓட்ட அம்புகள்","122761adab6f"],"cmd.pipe.help":["குழாய்ப் பாதையை அதன் மையக்கோட்டில் வரை: பொருள், வகுப்பு, பெயரளவு அளவைத் தேர்ந்தெடுக்கவும்; முழங்கைகள், குறைப்பிகள், டீகள் தானாக வரும்","ee7c97227b9a"],"cmd.pipe3d.help":["ஒவ்வொரு குழாய்ப் பாதையின் திடப்பொருள்களை 3D தாவலில் மீண்டும் உருவாக்கு","a6c08c98ed8c"],"cmd.pipenet.help":["ஒரு மூலப் புள்ளியிலிருந்து நீர் வழங்கல்: நீங்கள் தரும் சாதன அலகுகளிலிருந்து ஒவ்வொரு சாதனத்துக்கும் ஓட்டம், வேகம், இழந்த அழுத்தம் (PNET)","023c09c37a05"],"cmd.pipesched.help":["குழாய் மற்றும் பொருத்தி அட்டவணை, தானாகப் புதுப்பிக்கப்படும் அட்டவணையாக வைக்கப்படும்","97b02ecb398d"],"cmd.valve.help":["குழாய்ப் பாதைகளில் வால்வுகள், வடிகட்டிகள், ஃபிளேஞ்சுகள், யூனியன்களை வை (அல்லது எடு)","cbcb70c3708d"],"col.material":["பொருள்","616cb218a65b"],"col.size":["அளவு","1af851907331"],"col.slope":["சரிவு","b6df79f81a02"],"col.weight":["எடை ({unit})","e34581fed681"],"col.z0":["தொடக்க உயரம் ({unit})","6686b470ad16"],"col.z1":["முடிவு உயரம் ({unit})","31ead5b2e8a4"],"csv.fittings":["பொருத்திகளும் வால்வுகளும்","22ab0a909636"],"csv.pipe":["குழாய்","3725dbfedcd5"],"csv.runs":["பாதைகள்","848f54e89660"],"done.3d":["{n} குழாய்ப் பாதைகளுக்குத் திடப்பொருள்கள் மீண்டும் உருவாக்கப்பட்டன.","a493a68fcff1"],"done.3d.off":["திடப்பொருள்கள் அமைப்புகள் › CadCraft › குழாய் அமைப்பில் அணைக்கப்பட்டுள்ளன.","843cd07d9a44"],"done.pipe":["குழாய்ப் பாதை வரையப்பட்டது: {size} இன் {n} பகுதிகள், {len} {lu}.","92aee9a84aeb"],"done.slope":["{slope} சரிவு: அது {drop} {unit} இறங்குகிறது.","7e7ac022ecbc"],"done.table":["அட்டவணை வைக்கப்பட்டது. குழாய்கள் மாறும்போது அதுவும் பின்தொடரும்.","0d65d7fd2388"],"done.valves":["{n} வைக்கப்பட்டன.","734c336af908"],"err.nopipes":["வரைபடத்தில் குழாய்ப் பாதைகள் இல்லை.","d8de61eee43c"],"err.notpipe":["அங்கு குழாய் இல்லை.","e03a714056c9"],"err.run":["அந்தப் பாதையை வரைய முடியாது: இரு வேறு புள்ளிகள் தேவை.","5ede3e37bf27"],"err.size":["அந்த அளவு {mat} இல் தயாரிக்கப்படுவதில்லை.","5cdc1bb68099"],"err.slope":["அது சரிவு அல்ல: அடிக்கு அங்குலம் (1/4) அல்லது சதவீதம் (2%) எனத் தட்டச்சு செய்யவும்.","c76a48faf042"],"export.csv":["குழாய் அட்டவணை (CSV)","b3505a7bef09"],"export.pack":["TakeoffCraft க்கான குழாய்த் தொகுப்புகள் (பேக்)","82f2879a9e50"],"export.takeoff":["TakeoffCraft க்கான குழாய்கள் (அளவு கணக்கீட்டுடன் PDF)","40eb2d43e48d"],"fit.elbow":["முழங்கை {deg}° {size}","b9c46b820a9a"],"fit.elbow45":["45° முழங்கை {size}","7d6eff292868"],"fit.elbow90":["90° முழங்கை {size}","5f11ca04187c"],"fit.reducer":["குறைப்பி {from} × {to}","e5177f1fc264"],"fit.tee":["டீ {main}","36c9518ee45d"],"fit.tee.red":["குறைக்கும் டீ {main} × {branch}","71069704adaf"],"fit.wye":["ஒய் {main} × {branch}","53aed1d1e1b2"],"lines.double":["இரட்டைக் கோடு","18ea21944baf"],"lines.single":["ஒற்றைக் கோடு","d66572a513a8"],"mat.copper":["செப்புக் குழாய் (ASTM B88)","4e0d1ecfcaed"],"mat.copper.K":["செம்பு வகை K","011f1eea60c4"],"mat.copper.L":["செம்பு வகை L","eb0c848d6343"],"mat.copper.M":["செம்பு வகை M","b9767f00c9c4"],"mat.pex":["PEX குழாய் (ASTM F876)","43c85e801f60"],"mat.pex.SDR9":["PEX SDR 9","fc92bcca29b3"],"mat.pvc":["PVC குழாய் (ASTM D1785)","6e37d0c93e29"],"mat.pvc.40":["PVC Sch 40","5caa6a2bb88d"],"mat.pvc.80":["PVC Sch 80","15f5c0fc5ef6"],"mat.steel":["எஃகுக் குழாய் (ASME B36.10M)","61f29471ddaa"],"mat.steel.40":["எஃகு Sch 40","791dcc63181c"],"mat.steel.80":["எஃகு Sch 80","a8daa3f39ddf"],"net.avail":["மூலத்தில் வழங்கல் அழுத்தம் kPa இல் (0 = கொடுக்கப்படவில்லை)","cea16bbf8e76"],"net.beyond":["சில தேவை தேவை வளைவின் முடிவைத் தாண்டியது. மேலும் செல்ல உங்கள் விதிமுறையின் வளைவைத் தட்டச்சு செய்யவும்.","4ec159d688e1"],"net.defaults":["தேவை பெயரிடப்பட்ட இயல்பு வளைவைப் பயன்படுத்துகிறது; பொருத்தி இழப்புகள் முழுமையாக்கிய இயல்புகள். அவற்றை நம்புவதற்கு முன் உங்கள் பொறியாளருடன் சரிபார்க்கவும்.","f148530ea4ba"],"net.err.noends":["காலியான குழாய் முனைகள் எதுவும் கிடைக்கவில்லை, எனவே நீர் செல்ல இடம் இல்லை.","b687e141d57c"],"net.err.nopipes":["இந்த வரைபடத்தில் குழாய்ப் பாதைகள் இல்லை.","88f1488e3363"],"net.err.nosrc":["முதலில் PIPENET ஐ இயக்கி மூலத்தைக் கிளிக் செய்யவும், பிறகு ஏற்றுமதி செய்யவும்.","bb7829f8a0dc"],"net.err.source":["அந்தப் புள்ளி குழாய்ப் பாதையின் முனையில் இல்லை. வழங்கல் வரும் முனையைக் கிளிக் செய்யவும்.","748e40255830"],"net.export":["வழங்கல் வலையமைப்பு (CSV)","1f016fdb95a2"],"net.fixture":["முனை {tag} ({x}, {y}) இல் சாதனம்: {list}, அல்லது சாதன அலகுகளின் எண்ணிக்கை (0 = இல்லை)","553a6ef74a0f"],"net.head":["{n} சாதனங்கள். அழுத்தத்தில் மிகத் தொலைவில் உள்ளது: {worst}.","8c510375f0df"],"net.left":[", {v} kPa மிச்சம்{short}","a92eb0fb496c"],"net.load":["{label}: {fu} சாதன அலகுகள், {dp} kPa இழக்கிறது{left}","b46adaa12d24"],"net.load.no":["{label}: மூலத்துடன் இணைக்கப்படவில்லை","657a214055b0"],"net.min":["ஒரு சாதனத்தில் தேவையான அழுத்தம் kPa இல் (0 = கொடுக்கப்படவில்லை)","7f7f95924b7d"],"net.note.loop":["{n} குழாய் வளையங்கள் கண்டறியப்பட்டன. கணக்கீடு ஒரு மரத்தைப் பின்பற்றுவதால் வளையங்கள் புறக்கணிக்கப்படுகின்றன.","e856e2aadb9c"],"net.note.nofixture":["முனை {tag} {key} க்கு சாதனம் இல்லை, எனவே அது நீர் எடுக்காது.","e4f41711e573"],"net.note.unreached":["{n} குழாய்ப் பகுதிகள் மூலத்துடன் இணைக்கப்படவில்லை.","1516a7a79996"],"net.opt.pressure":["அழுத்தம்","1f8407f9eeb1"],"net.opt.reset":["மீட்டமை","daee7606b339"],"net.pressure.set":["வழங்கல் {a} kPa, சாதனத்தில் தேவை {m} kPa.","340dda8a1f9d"],"net.reset":["நீங்கள் பெயரிட்ட சாதனங்கள் மறக்கப்பட்டன.","c43cae8a32f7"],"net.short":[" (தேவையானதை விடக் குறைவு)","9bbfe701b0e5"],"net.sizes":["{n} பாதைகள் தங்கள் ஓட்டத்துக்கு மிகச் சிறியவை (வேகமானவை) அல்லது தேவையை விட மிகப் பெரியவை: {list}.","79e9c616ac82"],"net.source":["மூலம்: வழங்கல் வரும் குழாய்ப் பாதையின் முனையில் கிளிக் செய்யவும் [அழுத்தம் (P)/சாதனங்களை மீட்டமை (R)]","47b6663a2009"],"opt.lines":["கோடுகள்","3b26a5427458"],"opt.material":["பொருள்","616cb218a65b"],"opt.slope":["சரிவு","b6df79f81a02"],"pack.assume.count":["வரைபடத்தில் ஒவ்வொரு பொருத்திக்கும் வால்வுக்கும் ஒன்று; மூட்டுகள் (பற்றவைப்பு, சாலிடர், கரைப்பான்) எண்ணப்படவில்லை.","f2c5791a1c32"],"pack.assume.pipe":["நீளம் பொருத்திகள் வழியாக மையத்துக்கு மையம், சரிவு வழியே; எஃகு எடை ASME B36.10M இன்படி வெற்று முனை எடை.","58d86b861737"],"pack.description":["ஒரு CadCraft வரைபடத்தின் குழாய், பொருத்தி, வால்வு உருப்படிகள்; எஃகுக் குழாய் அதன் எடையுடன். விலைகள் இல்லை: உங்களுடையதை அமைக்கவும்.","0f03dfdbd2a3"],"pack.name":["{name} இல் குழாய்கள்","54d6f45cb08d"],"pack.source.by":["CadCraft குழாய் துணை நிரல்","e9001aa06a85"],"pack.source.drawn":["வரைபடத்தில் அளந்த நீளங்கள், பொருத்திகள் வழியாக மையத்துக்கு மையம்","cf56626718a0"],"pack.trade":["குழாய் அமைப்பு","15ecf273da29"],"panel.facts":["{n} குழாய்ப் பாதைகள்: {len} {lu}, {f} பொருத்திகள், {v} வால்வுகள்.","ecd48352babb"],"panel.none":["இன்னும் குழாய்ப் பாதைகள் இல்லை: PIPE எனத் தட்டச்சு செய்யவும்.","0a12c74d0f90"],"pipe.name":