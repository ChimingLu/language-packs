{"@format":"cadcraft-lang-layer","@layer":"addon.cabinet","@locale":"ta","s":{"ask.cab":["{type} கேபினெட் அகலம், அல்லது அதன் முனையைக் கிளிக் செய்யவும் ({w} வழக்கமானது; {len} இல் {at} இடத்தில்) [அடி (B)/இழுப்பறை அடி (D)/சுவர் (W)/உயரமான (T)/இடைவெளி (G)/செயல்தவிர் (U)] (முடிக்க Enter):","0cc8587c0808"],"ask.elev.at":["முன் தோற்றம் எங்கே வர வேண்டும்?","ed39a6ef67a1"],"ask.elev.pick":["வரைய வேண்டிய சுவரில் உள்ள ஒரு கேபினெட்டைத் தேர்ந்தெடுக்கவும்:","1310a678a282"],"ask.gap":["விட வேண்டிய இடைவெளி:","2bf64f388ae0"],"ask.room":["சுவரின் அறைப் பக்கத்தில் கிளிக் செய்யவும்:","88787aaf3317"],"ask.side.at":["பக்கத் தோற்றம் எங்கே வர வேண்டும்?","f90c43e08309"],"ask.side.pick":["பக்கத்திலிருந்து வரைய வேண்டிய கேபினெட்டைத் தேர்ந்தெடுக்கவும்:","88864febbdda"],"ask.wall.a":["சுவர்க் கோட்டின் முதல் புள்ளி:","12dbacee8ff7"],"ask.wall.b":["சுவர்க் கோட்டின் இரண்டாவது புள்ளி:","4d8721134da0"],"back.applied":["பின்புறத்தில் பொருத்தி","6c8716fa93f1"],"back.between":["பலகைகளுக்கு இடையில்","8d60c7fd3121"],"band.edge":["விளிம்பு {t} {unit}","b6b5c4f487ee"],"cmd.cab3d.help":["கேபினெட்டுகளைத் திடப்பொருள்களாக 3D தாவலில் வை (திடப்பொருள் அமைப்பு இயக்கத்தில் இருக்கும்போது புதுப்பிக்கப்பட்டபடியே இருக்கும்).","086d27f7fa50"],"cmd.cabdrill.help":["ஒவ்வொரு கேபினெட்டின் 32 mm துளையிடல்: அடுக்குப் பின்கள், கீல் கோப்பைகளும் தகடுகளும், இழுப்பறை ஸ்லைடு துளைகள்.","fef5d5b57c48"],"cmd.cabelev.help":["ஒரு சுவரில் உள்ள கேபினெட்டுகளின் முன் தோற்றத்தை வரை; அது புதுப்பிக்கப்பட்டபடியே இருக்கும்.","cb054a62a3fa"],"cmd.cabhard.help":["வன்பொருள் பட்டியல்: கீல்கள், தகடுகள், அடுக்குப் பின்கள், ஸ்லைடுகள், கால்கள், பிராக்கெட்டுகள், இழுப்புக் கைப்பிடிகள், இணைப்பிகள்.","5a70a3665307"],"cmd.cabinet.help":["சுவரோரம் கேபினெட்டுகளை வை: சுவர்க் கோட்டையும் அறைப் பக்கத்தையும் குறிப்பிட்டு, ஒவ்வொரு கேபினெட்டின் அகலத்தையும் தட்டச்சு செய்யவும்.","f187bc2b4f8f"],"cmd.cablist.help":["ஒவ்வொரு கேபினெட்டின் வெட்டுப்பட்டியல்: பொருளின்படி துண்டுகளும் பரப்பளவும், விளிம்புப் பட்டை, சிக்கல்கள்.","8f1d82255f5f"],"cmd.cabnest.help":["ஒவ்வொரு பொருளையும் தகடுகளில் அடுக்கி, வேலைக்கு எத்தனை தகடுகள் தேவை எனச் சொல்.","927e3d096aea"],"cmd.cabside.help":["கேபினெட்டை நடுவில் வெட்டிப் பக்கத்திலிருந்து பார்த்தபடி வரை: பலகைகள், பின்பலகை, அடுக்குகள், அடிப்பீடம், முகப்புகள்.","50719a862d57"],"csv.cutlength":["வெட்டு நீளம்","3818d97b0724"],"csv.cutwidth":["வெட்டு அகலம்","aebfc3a6b378"],"csv.grain":["இழை","540faafbd767"],"csv.group":["கேபினெட்","4295f6e42f3f"],"csv.id":["பாகம்","8570a2e1669f"],"csv.l1":["L1","dffe8596427f"],"csv.l2":["L2","d76354d84578"],"csv.length":["நீளம்","adc95605a1b3"],"csv.material":["பொருள்","616cb218a65b"],"csv.name":["பெயர்","dcd1d5223f73"],"csv.note":["குறிப்பு","d8da2c49df39"],"csv.qty":["எண்.","a9be9c3e9ab6"],"csv.thickness":["தடிமன்","7b5944144275"],"csv.w1":["W1","4bb48e76f19d"],"csv.w2":["W2","156168609829"],"csv.width":["அகலம்","3019947b6daf"],"csvd.depth":["ஆழம்","f1dbc33978a9"],"csvd.diameter":["விட்டம்","54a7193484e0"],"csvd.face":["முகம்","304afc32b7ff"],"csvd.kind":["துளை","c4061b600b85"],"csvd.name":["பெயர்","dcd1d5223f73"],"csvd.note":["குறிப்பு","d8da2c49df39"],"csvd.part":["பாகம்","8570a2e1669f"],"csvd.qty":["எண்.","a9be9c3e9ab6"],"csvd.side":["பக்கம்","630ef00b7c4f"],"csvd.x":["X","4b68ab3847fe"],"csvd.y":["Y","18f5384d58bc"],"csvh.spec":["அளவு","1af851907331"],"done.3d":["3D தாவலில் கேபினெட்டுகள்: {n}.","1a5f87e3f1cd"],"done.cab":["{no}: {type} கேபினெட், {w} அகலம்.","16bc19ad7908"],"done.drill":["மொத்தம் {holes} துளைகள் (ஒரு பக்கம் இரண்டில் ஒரு பாகம்: அதன் உள் முகத்தில் துளையிடவும்).","9df61af98f9e"],"done.drill.export":["EXPORT › Cabinet drilling (CSV) ஒவ்வொரு துளையையும் எழுதும்: x பாகத்தின் நீளவாக்கிலும், y குறுக்காகவும், உதவியில் குறிப்பிட்ட விளிம்புகளிலிருந்து.","cfdf67436909"],"done.elev":[{"one":"1 கேபினெட்டின் முன் தோற்றம்.","other":"{n} கேபினெட்டுகளின் முன் தோற்றம்."},"0ca3c9652bb0"],"done.hard":["{n} வன்பொருள் வரிகள்.","50a79c694923"],"done.hard.export":["EXPORT › Cabinet hardware (CSV) பட்டியலை எழுதும்.","05eaac63e8c6"],"done.list":["{cabs} கேபினெட்டுகள், {pieces} துண்டு