4"],"libitem.mesh.gltf_extension":["கோப்புக்கு {extension} நீட்டிப்பு தேவை, அது ஆதரிக்கப்படவில்லை.","70a13c737ba6"],"libitem.mesh.gltf_lines":[{"one":"{n} பகுதி கோடுகள் அல்லது புள்ளிகள், முக்கோணங்கள் அல்ல, விடப்பட்டது.","other":"{n} பகுதிகள் கோடுகள் அல்லது புள்ளிகள், முக்கோணங்கள் அல்ல, விடப்பட்டன."},"c8011bf3f164"],"libitem.mesh.gltf_none":["glTF கோப்பில் முக்கோணங்கள் எதுவும் இல்லை.","2a47bc96dfa8"],"libitem.mesh.gltf_units":["glTF வரையறைப்படி மீட்டரில் உள்ளது; கேட்டபடி {units} ஆகப் படிக்கப்பட்டது.","411d99984369"],"libitem.mesh.gltf_unreadable":["படிக்கக்கூடிய glTF கோப்பு அல்ல.","4f21c7e27412"],"libitem.mesh.gltf_version":["glTF 2.0 மட்டுமே ஆதரிக்கப்படுகிறது.","138c50d141d4"],"libitem.mesh.moved":["பின்புற நடுவும் அடிப்பகுதியும் செருகுப் புள்ளியாகும்படி நகர்த்தப்பட்டது.","d54f8601a422"],"libitem.mesh.obj_faces_skipped":[{"one":"{n} முகம் இல்லாத முனைகளைச் சுட்டியது, விடப்பட்டது.","other":"{n} முகங்கள் இல்லாத முனைகளைச் சுட்டின, விடப்பட்டன."},"523a54b62d91"],"libitem.mesh.obj_none":["OBJ கோப்பில் முக்கோணங்கள் எதுவும் இல்லை.","2dca18600f59"],"libitem.mesh.obj_units":["OBJ கோப்புகளில் அலகுகள் இல்லை: மில்லிமீட்டராகப் படிக்கப்பட்டது. தவறெனில் அலகுகளைத் தேர்ந்தெடுக்கவும்.","0d639ee4b9ac"],"libitem.mesh.obj_up":["Y மேல் என்று படிக்கப்பட்டது (வழக்கமான OBJ மரபு). உருப்படி முதுகில் கிடந்தால் Z மேல் என்பதைத் தேர்ந்தெடுக்கவும்.","59b970d4151b"],"libitem.mesh.stl_corner":["STL கோப்பில் எண் அல்லாத மூலை உள்ளது.","fc19e54b02e6"],"libitem.mesh.stl_degenerate":[{"one":"பரப்பளவு இல்லாத {n} முக்கோணம் விடப்பட்டது.","other":"பரப்பளவு இல்லாத {n} முக்கோணங்கள் விடப்பட்டன."},"624cab2547e2"],"libitem.mesh.stl_none":["STL கோப்பில் முக்கோணங்கள் எதுவும் இல்லை.","cc91c00850b3"],"libitem.mesh.stl_units":["STL கோப்புகளில் அலகுகள் இல்லை: மில்லிமீட்டராகப் படிக்கப்பட்டது. தவறெனில் அலகுகளைத் தேர்ந்தெடுக்கவும்.","882f6f6b19f7"],"libitem.mesh.stl_unreadable":["படிக்கக்கூடிய STL கோப்பு அல்ல.","fd011a8b74dc"],"libitem.mesh.stl_up":["Z மேல் என்று படிக்கப்பட்டது (வழக்கமான STL மரபு). உருப்படி முதுகில் கிடந்தால